                        "translation": [0.0, 0.1, 0.0],
                        "scale": [1.0, 1.0, 1.0],
                        "left_rotation": [0.0, 0.0, 0.0, 1.0],
                        "right_rotation": [0.0, 0.0, 0.0, 1.0]
                    },
                    "tints": [
                        {
                            "type": "minecraft:dye",
                            "default": [1.0, 1.0, 1.0]
                        }
                    ]
                }
